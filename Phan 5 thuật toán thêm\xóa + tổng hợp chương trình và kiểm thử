        cout << "4. Tim kiem theo ma nhan vien\n";
        cout << "5. Bo sung nhan vien\n";
        cout << "6. Xoa nhan vien\n";
        cout << "0. Thoat\n";
        cout << "=======================================\n";

        cout << "Nhap lua chon: ";
        cin >> luaChon;

        switch (luaChon) {
        case 1:
            ql.nhapDanhSach();
            break;

        case 2:
            ql.xuatDanhSach();
            break;

        case 3:
            ql.sapXepLuongGiamDan();
            break;

        case 4:
            ql.timKiem();
            break;

        case 5:

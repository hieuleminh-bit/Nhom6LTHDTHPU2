void boSungNhanVien(NhanVien ds[], int *n) {
    if (*n >= MAX_NV) {
        printf("\nDanh sach da day, khong the them nhan vien moi!\n");
        return;
    }

    int vt;
    printf("\nNhap vi tri can chen (1 den %d): ", *n + 1);
    scanf("%d", &vt);

    if (vt < 1 || vt > *n + 1) {
        printf("Vi tri khong hop le!\n");
        return;
    }
    for (int i = *n; i >= vt; i--) {
        ds[i] = ds[i - 1];
    }

    printf("\n--- Nhap thong tin nhan vien can bo sung ---\n");
    nhap1NhanVien(&ds[vt - 1]);
    (*n)++;

    printf("=> Da bo sung nhan vien vao vi tri %d thanh cong!\n", vt);
}
void xoaNhanVien(NhanVien ds[], int *n) {
    if (*n == 0) {
        printf("\nDanh sach rong, khong the xoa!\n");
        return;
    }

    int vt;
    printf("\nNhap vi tri nhan vien can xoa (1 den %d): ", *n);
    scanf("%d", &vt);

    if (vt < 1 || vt > *n) {
        printf("Vi tri khong hop le!\n");
        return;
    }

    // Dá»‹ch chuyá»ƒn cÃ¡c pháº§n tá»­ Ä‘áº±ng sau sang trÃ¡i
    for (int i = vt - 1; i < *n - 1; i++) {
        ds[i] = ds[i + 1];
    }
    (*n)--;

    printf("=> Da xoa nhan vien tai vi tri %d thanh cong!\n", vt);
}

int main() {
    NhanVien ds[MAX_NV];
    int n = 0;
    int chon;

    do {
        printf("\n================ MENU QUAN LY NHAN VIEN ================\n");
        printf("1. Nhap danh sach nhan vien\n");
        printf("2. In danh sach nhan vien\n");
        printf("3. Sap xep danh sach theo luong thuc linh giam dan\n");
        printf("4. Tim kiem nhan vien theo ma\n");
        printf("5. Bo sung 1 nhan vien vao vi tri cho truuoc\n");
        printf("6. Xoa 1 nhan vien tai vi tri cho truuoc\n");
        printf("0. Thoat chuong trinh\n");
        printf("========================================================\n");
        printf("Chon chuc nang (0-6): ");
        scanf("%d", &chon);

        switch (chon) {
            case 1:
                nhapDanhSach(ds, &n);
                break;
            case 2:
                inDanhSach(ds, n);
                break;
            case 3:
                sapXepGiamDanTheoLuong(ds, n);
                inDanhSach(ds, n);
                break;
            case 4:
                timKiemTheoMa(ds, n);
                break;
            case 5:
                boSungNhanVien(ds, &n);
                break;
            case 6:
                xoaNhanVien(ds, &n);
                break;
            case 0:
                printf("\nDa thoat chuong trinh. Tam biet!\n");
                break;
            default:
                printf("\nLuachon khong hop le! Vui long chon lai.\n");
        }
    } while (chon != 0);

    return 0;
}
